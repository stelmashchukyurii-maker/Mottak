rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /mottakDrafts/{sessionId} {
      // Test model: anonymous Firebase Authentication is required.
      // Direct document access is allowed, but collection listing is denied.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.sessionId == sessionId
        && request.resource.data.product == 'bunner'
        && request.resource.data.expectedCount >= 1
        && request.resource.data.expectedCount <= 60
        && request.resource.data.status == 'draft';
      allow update: if request.auth != null
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.product == resource.data.product
        && request.resource.data.expectedCount == resource.data.expectedCount
        && request.resource.data.status in ['draft', 'finalized']
        && (resource.data.status == 'draft' || request.resource.data.status == 'finalized');
      allow delete: if false;
    }
  }
}
